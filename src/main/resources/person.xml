<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="person" class="com.rays.test.Person">


		<property name="name" value="ram">
		</property>
		<property name="address" value="indore"></property>
	</bean>

	<bean id="employee" class="com.rays.test.Employee">

		<constructor-arg value="ram"></constructor-arg>
		<constructor-arg value="tcs"></constructor-arg>
		<constructor-arg value="5000"></constructor-arg>
	</bean>

</beans>